# Local-only settings for scripts/run-local.ps1 and compose.local.yaml.
# Copy to .env.local (git-ignored). Never use production values here.
PUBLIC_BETA_MODE=true
PUBLIC_BETA_MAX_ACTIVE_TOURNAMENTS=25
ENABLE_HOST_PLAY=true
ENABLE_SOLO_BOTS=true
ENABLE_CHALLENGE_QUEUE=true
ADMIN_EMAILS=you@example.com
# Google sign-in (optional): OAuth 2.0 Client ID from Google Cloud Console.
# Authorized JavaScript origins must include http://localhost:3000 and http://localhost:5173.
# Leave empty to hide the Google button. No client secret is needed.
GOOGLE_CLIENT_ID=
# AI Pack Forge (optional): Meta Model API key from dev.meta.ai. Leave empty to disable the Forge.
MODEL_API_KEY=