# Local-only settings for scripts/run-local.ps1 and compose.local.yaml.
# Copy to .env.local (git-ignored) and change the passwords. Never use these on EC2.
FREE_ACCOUNT_EMAIL=free@zerosum.local
FREE_ACCOUNT_PASSWORD=local-free-password-123
PAID_ACCOUNT_EMAIL=paid@zerosum.local
PAID_ACCOUNT_PASSWORD=local-paid-password-123
PUBLIC_BETA_MODE=true
PUBLIC_BETA_MAX_ACTIVE_TOURNAMENTS=25
ENABLE_HOST_PLAY=true
ENABLE_SOLO_BOTS=true
ENABLE_CHALLENGE_QUEUE=true
