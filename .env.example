# ZeroSum Arena configuration template.
# Copy to ".env.local" for local runs (scripts/run-local.ps1, compose.local.yaml)
# or to ".env" for the self-host Docker setup (compose.yaml).
# Never commit a filled-in copy of this file.
PUBLIC_BETA_MODE=true
PUBLIC_BETA_MAX_ACTIVE_TOURNAMENTS=25
ENABLE_HOST_PLAY=true
ENABLE_SOLO_BOTS=true
ENABLE_CHALLENGE_QUEUE=true
# Comma-separated account emails that receive admin rights (pack visibility tools).
ADMIN_EMAILS=you@example.com
# Google sign-in (optional): OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services > Credentials > Web application). Authorized JavaScript
# origins must include every origin that serves the app, e.g.
# https://your-domain.example and http://localhost:3000 for local development.
# Leave empty to hide the Google button. No client secret is needed.
GOOGLE_CLIENT_ID=
# AI Pack Forge (optional): Meta Model API key from dev.meta.ai.
# Leave empty to disable the Forge.
MODEL_API_KEY=
# Optional model override (defaults to muse-spark-1.3).
META_MODEL=
